NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Server only. Never use a NEXT_PUBLIC prefix for this key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
APP_ORIGIN=https://thirstcafe.in
# Set true only behind a trusted proxy that replaces X-Forwarded-For.
# Otherwise public franchise submissions share a conservative rate limit.
TRUST_PROXY=false
